{
  "name": "archlens",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "contracts:gen": "dotnet build services/ArchLens.Core && pnpm -C packages/contracts gen",
    "core:dev": "dotnet run --project services/ArchLens.Core",
    "core:test": "dotnet test ArchLens.slnx",
    "test:report": "pnpm test:report:core && pnpm test:report:web",
    "test:report:core": "dotnet test ArchLens.slnx --logger \"trx;LogFilePrefix=results\" --logger \"html;LogFilePrefix=results\" --results-directory artifacts/test-results",
    "test:report:web": "pnpm -C apps/web test --reporter=default --reporter=junit --outputFile.junit=../../artifacts/test-results/web-junit.xml"
  },
  "pnpm": {
    "overrides": {
      "typescript": "6.0.2"
    }
  }
}
